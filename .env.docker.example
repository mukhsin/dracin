# Drama Streaming App - Docker Environment Configuration
# Copy this file to .env.docker and update the values

# Database Configuration
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=dracin
DATABASE_USER=drama
DATABASE_PASSWORD=change_this_secure_password

# Better Auth Configuration
BETTER_AUTH_SECRET=your-very-long-secret-key-here-at-least-32-characters
BETTER_AUTH_URL=https://dracin.mukhsin.web.id

# Resend Auth Configuration
RESEND_API_KEY=xxxx
RESEND_FROM_EMAIL=noreply@dracin.mukhsin.web.id

# API Configuration
PRIMARY_API_URL=http://api:3001
API_PROXY_URL=http://api-proxy:3002

# Web Configuration
# Web code calls `${VITE_API_URL}/api/...` so this should be your public domain.
VITE_API_URL=https://dracin.mukhsin.web.id

# api-proxy
SECRET_KEY=replace_with_your_private_key

# cloudflared
# Token from Cloudflare Zero Trust tunnel dashboard.
CLOUDFLARED_TOKEN=replace_with_your_tunnel_token

# Node Environment
NODE_ENV=production
