import { Link } from "@tanstack/react-router";

interface ContinueWatchingButtonProps {
  dramaSlug: string;
  lastWatchedEpisode: number | null;
  lastEpisodeCompleted: boolean;
  totalEpisodes: number;
  searchQuery?: string;
}

export function ContinueWatchingButton({
  dramaSlug,
  lastWatchedEpisode,
  lastEpisodeCompleted,
  totalEpisodes,
  searchQuery,
}: ContinueWatchingButtonProps) {
  let targetEpisode: number;
  let label: string;

  if (!lastWatchedEpisode) {
    // Never watched any episode
    targetEpisode = 1;
    label = "Start Watching";
  } else if (lastEpisodeCompleted) {
    // Last episode is finished, go to next
    if (lastWatchedEpisode >= totalEpisodes) {
      // All episodes completed
      targetEpisode = 1;
      label = "Watch Again";
    } else {
      // Continue to next episode
      targetEpisode = lastWatchedEpisode + 1;
      label = "Continue Watching";
    }
  } else {
    // Last episode is unfinished, resume it
    targetEpisode = lastWatchedEpisode;
    label = `Resume Episode ${lastWatchedEpisode}`;
  }

  return (
    <Link
      to="/dramas/$dramaSlug/$episodeNumber"
      params={{
        dramaSlug,
        episodeNumber: targetEpisode.toString(),
      }}
      state={searchQuery ? { searchQuery } : undefined}
      className="text-sm font-semibold text-primary-foreground bg-primary px-4 py-2 border border-primary transition-all hover:bg-primary/90"
    >
      {label}
    </Link>
  );
}
