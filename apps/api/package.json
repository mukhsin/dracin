{
  "name": "@repo/api",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --noEmit false --outDir ./dist",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:import-sql": "bun run src/db/import-sql-data.ts"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.20",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7",
    "@libsql/client": "^0.17.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.7.3"
  }
}
